{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "veryAgent",
  "version": "1.0.0",
  "identifier": "app.veryagent",
  "build": {
    "beforeDevCommand": "pnpm tauri:before-dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "pnpm tauri:before-build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../out": "web/"
    },
    "externalBin": [
      "binaries/veryagent-mcp"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dangerousInsecureTransportProtocol": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RTg3OTkwRDlFNzlFRDUKUldUVm51ZlprSG5vU0MvS1N2QzJzYldpWjM3WFhGcjhMYTFCaUt4V2JUSDdqdDlVbG5pZTU2N0YK",
      "endpoints": [
        "https://github.com/plhys/VeryAgent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
